# Environment Configuration
# Copy this file to .env and update with your values

# Application
APP_NAME="Task Management API"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql://taskuser:taskpass@localhost:5432/taskdb
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_POOL_SIZE=10

# Security
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_BURST=20

# Email
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@taskmanager.com
EMAIL_USE_TLS=true

# External Services
SENTRY_DSN=
OPENTELEMETRY_ENABLED=false
OPENTELEMETRY_ENDPOINT=http://localhost:4317

# Feature Flags
FEATURE_WEBSOCKETS=false
FEATURE_SEARCH=true
FEATURE_NOTIFICATIONS=false
FEATURE_TEMPLATES=false

# Webhooks
WEBHOOK_TIMEOUT=30
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=60

# File Storage
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_EXTENSIONS=["jpg", "jpeg", "png", "pdf", "doc", "docx"]
STORAGE_TYPE=local
STORAGE_PATH=/var/uploads

# Monitoring
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Testing
TEST_DATABASE_URL=postgresql://testuser:testpass@localhost:5432/taskdb_test
TESTING=false