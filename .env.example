# SizeComparator Configuration
# Copy this file to .env and set your values

# Environment
SIZECOMPARATOR_ENV=development
SIZECOMPARATOR_DEBUG=true

# API Configuration
SIZECOMPARATOR_API_HOST=0.0.0.0
SIZECOMPARATOR_API_PORT=8000
SIZECOMPARATOR_API_WORKERS=1

# AI Provider API Keys (at least one required)
SIZECOMPARATOR_OPENAI_API_KEY=sk-your-openai-key-here
SIZECOMPARATOR_ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
SIZECOMPARATOR_XAI_API_KEY=xai-your-xai-key-here

# AI Provider Settings
SIZECOMPARATOR_OPENAI_MODEL=gpt-4
SIZECOMPARATOR_OPENAI_TIMEOUT=30
SIZECOMPARATOR_OPENAI_MAX_TOKENS=500
SIZECOMPARATOR_OPENAI_TEMPERATURE=0.3

SIZECOMPARATOR_ANTHROPIC_MODEL=claude-3-sonnet-20240229
SIZECOMPARATOR_ANTHROPIC_TIMEOUT=60
SIZECOMPARATOR_ANTHROPIC_MAX_TOKENS=1000
SIZECOMPARATOR_ANTHROPIC_TEMPERATURE=0.0

SIZECOMPARATOR_XAI_MODEL=grok-beta
SIZECOMPARATOR_XAI_TIMEOUT=45

# Cache Configuration
SIZECOMPARATOR_CACHE_PROVIDER=memory
SIZECOMPARATOR_CACHE_TTL=3600
SIZECOMPARATOR_CACHE_MAX_SIZE=1000

# Redis Configuration (if using Redis cache)
SIZECOMPARATOR_REDIS_HOST=localhost
SIZECOMPARATOR_REDIS_PORT=6379
SIZECOMPARATOR_REDIS_DB=0
SIZECOMPARATOR_REDIS_PASSWORD=
SIZECOMPARATOR_REDIS_TLS=false

# Service Factory Configuration
SIZECOMPARATOR_SERVICE_STRATEGY=smart_routing
SIZECOMPARATOR_FORCE_BASIC_SERVICE=false
SIZECOMPARATOR_REQUIRE_VALIDATION=true
SIZECOMPARATOR_SERVICE_TIMEOUT_MS=5000

# Security
SIZECOMPARATOR_SECRET_KEY=dev-secret-key-change-in-production
SIZECOMPARATOR_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Feature Flags
SIZECOMPARATOR_FEATURE_ENHANCED_VIZ=true
SIZECOMPARATOR_FEATURE_AI_SUGGESTIONS=false

# Monitoring
SIZECOMPARATOR_METRICS_ENABLED=true
SIZECOMPARATOR_LOG_LEVEL=INFO
SIZECOMPARATOR_LOG_FORMAT=json

# Cost Management
SIZECOMPARATOR_COST_TRACKING_ENABLED=true
SIZECOMPARATOR_DAILY_COST_LIMIT=10.0
SIZECOMPARATOR_MONTHLY_COST_LIMIT=100.0
SIZECOMPARATOR_COST_ALERT_THRESHOLD=0.8
SIZECOMPARATOR_COST_ALERT_EMAIL=admin@weightwhat.xyz
SIZECOMPARATOR_MAX_PARALLEL_CALLS=2
SIZECOMPARATOR_RATE_LIMIT_PER_MINUTE=60
SIZECOMPARATOR_RATE_LIMIT_PER_HOUR=1000