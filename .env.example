# Weight, What? Configuration
# Copy this file to .env and set your values

# Environment
SIZECOMPARATOR_ENV=development
SIZECOMPARATOR_DEBUG=true

# AI Provider API Keys (at least one required)
SIZECOMPARATOR_OPENAI_API_KEY=sk-your-openai-key-here
SIZECOMPARATOR_ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
SIZECOMPARATOR_XAI_API_KEY=xai-your-xai-key-here

# Model Selection (optional - defaults shown)
SIZECOMPARATOR_OPENAI_MODEL=gpt-4o-mini
SIZECOMPARATOR_ANTHROPIC_MODEL=claude-3-sonnet-20240229
SIZECOMPARATOR_XAI_MODEL=grok-beta

# Security (CHANGE THIS IN PRODUCTION)
SIZECOMPARATOR_SECRET_KEY=dev-secret-key-change-in-production
SIZECOMPARATOR_CORS_ORIGINS=http://localhost:8000,https://weightwhat.xyz

# Service Settings
SIZECOMPARATOR_DEFAULT_SERVICE_MODE=fast_validation
SIZECOMPARATOR_FORCE_BASIC_SERVICE=false

# Cache (optional)
SIZECOMPARATOR_CACHE_PROVIDER=memory
SIZECOMPARATOR_REDIS_HOST=localhost
SIZECOMPARATOR_REDIS_PORT=6379

# Cost Management (optional)
SIZECOMPARATOR_DAILY_API_COST_LIMIT=10.0
SIZECOMPARATOR_MONTHLY_API_COST_LIMIT=100.0