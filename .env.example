# SizeComparator Environment Configuration

# Application Settings
SIZECOMPARATOR_ENVIRONMENT=development
SIZECOMPARATOR_LOG_LEVEL=info
SIZECOMPARATOR_LOG_FORMAT=json
SIZECOMPARATOR_API_HOST=0.0.0.0
SIZECOMPARATOR_API_PORT=8000
SIZECOMPARATOR_WORKERS=1

# AI Provider API Keys (Required)
SIZECOMPARATOR_OPENAI_API_KEY=sk-your-openai-key-here
SIZECOMPARATOR_ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
SIZECOMPARATOR_XAI_API_KEY=xai-your-xai-key-here

# AI Provider Configuration
SIZECOMPARATOR_AI_TIMEOUT_SECONDS=30
SIZECOMPARATOR_AI_MAX_RETRIES=3
SIZECOMPARATOR_AI_CIRCUIT_BREAKER_THRESHOLD=5

# Weight Processing Configuration
SIZECOMPARATOR_MAX_WEIGHT_LBS=1000000
SIZECOMPARATOR_MAX_WEIGHT_KG=453592
SIZECOMPARATOR_MIN_WEIGHT_GRAMS=0.001

# Monitoring and Metrics
SIZECOMPARATOR_METRICS_ENABLED=true
SIZECOMPARATOR_METRICS_PORT=9090
SIZECOMPARATOR_HEALTH_CHECK_INTERVAL=30

# Development Settings
SIZECOMPARATOR_DEBUG=true
SIZECOMPARATOR_RELOAD=true
SIZECOMPARATOR_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Cache Configuration (Optional)
SIZECOMPARATOR_CACHE_TTL_SECONDS=300
SIZECOMPARATOR_CACHE_MAX_SIZE=1000

# Security Settings
SIZECOMPARATOR_REQUEST_TIMEOUT_SECONDS=30
SIZECOMPARATOR_RATE_LIMIT_REQUESTS=100
SIZECOMPARATOR_RATE_LIMIT_PERIOD=60